<!DOCTYPE html>
<html lan="en">
    <head>
        <meta charset="utf-8">
        <header class="main-header">
  <h1>Welcome to Tradehub</h1>
  <p>Trade items safely and easily with people near you.</p>
  <nav>
    <a href="#register">Register</a>
    <a href="#login">Login</a>
    <a href="#marketplace">Browse Listings</a>
  </nav>
</header>

    </head>
    <body>
        

<section id="register" class="auth-section">
  <h2>Create Account</h2>
  <form id="registerForm">
    <label for="registerUsername">Username:</label>
    <input type="text" id="registerUsername" required>

    <label for="registerEmail">Email:</label>
    <input type="email" id="registerEmail" required>

    <label for="registerPassword">Password:</label>
    <input type="password" id="registerPassword" required>

    <button type="submit">Register</button>
  </form>
</section>
<p> Already have an account?</p>
<section id="login" class="auth-section">
  <h2>Login</h2>
  <form id="loginForm">
    <label for="loginEmail">Email:</label>
    <input type="email" id="loginEmail" required>

    <label for="loginPassword">Password:</label>
    <input type="password" id="loginPassword" required>

    <button type="submit">Login</button>
  </form>
</section>

<section id="marketplace" class="listing-section">
  <h2>Available Items</h2>
  <div class="item-grid">
    <div class="item-card">
      <img src="placeholder.jpg" alt="Item Image">
      <h3>Item Name</h3>
      <p>Short description...</p>
      <button>View Details</button>
    </div>
  </div>
</section>
<section id="profile" class="profile-section">
  <h2>Your Profile</h2>
  <div class="profile-info">
    <p><b>Username:</b> yourusername</p>
    <p><b>Email:</b> %@%.%</p>
    
  </div>

  <h3>Your Listings</h3>
  <div class="user-items">
    <div class="item-card">
      <img src="item1.jpg" alt="User Item">
      
    </div>
  </div>
</section>
<section class="upload-section">
  <h2>List an Item for Trade</h2>
  <form id="uploadForm">
    <label for="itemTitle">Item Title:</label>
    <input type="text" id="itemTitle" name="itemTitle" required>

    <label for="itemDescription">Description:</label>
    <textarea id="itemDescription" name="itemDescription" rows="4" required></textarea>

    <label for="itemImage">Upload Image:</label>
    <input type="file" id="itemImage" name="itemImage" accept="image/*" required>

    <button type="submit">Submit</button>
  </form>

  <div class="preview-section">
    <h3>Preview:</h3>
    <div id="imagePreview"></div>
  </div>
</section>
    </body>
</html>
